function M.applyResize(win)
    if not win then return false, "no window" end
    windowRef = win

    if not win.main then
        task.defer(function()
            if win.main then
                M.applyResize(win)
            end
        end)
        return false, "main not ready"
    end

    if not originalSize then
        originalSize = win.main.AbsoluteSize
    end

    if win.main:FindFirstChild("__ResizeGrip") then
        resizeApplied = true
        return true
    end

    local grip = Instance.new("TextButton")
    grip.Name = "__ResizeGrip"
    grip.Size = UDim2.fromOffset(16, 16)
    grip.AnchorPoint = Vector2.new(1, 1)
    grip.Position = UDim2.new(1, -4, 1, -4)
    grip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    grip.BackgroundTransparency = 0.7
    grip.BorderSizePixel = 0
    grip.Text = ""
    grip.AutoButtonColor = false
    grip.ZIndex = 9999
    grip.Parent = win.main

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = grip

    local dragging = false
    local dragStart = Vector2.zero
    local startSize = Vector2.zero

    addConn(grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = UIS:GetMouseLocation()
            startSize = win.main.AbsoluteSize
        end
    end))

    addConn(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    addConn(UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta = UIS:GetMouseLocation() - dragStart

        local newX = startSize.X + delta.X
        local newY = startSize.Y + delta.Y

        local maxX = originalSize.X
        local maxY = originalSize.Y
        local minX = math.floor(originalSize.X * MIN_SCALE)
        local minY = math.floor(originalSize.Y * MIN_SCALE)

        newX = math.clamp(newX, minX, maxX)
        newY = math.clamp(newY, minY, maxY)

        win.main.Size = UDim2.fromOffset(math.floor(newX), math.floor(newY))
    end))

    resizeApplied = true
    return true
end
